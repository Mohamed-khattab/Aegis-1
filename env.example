# ===================
# Database Configuration
# ===================
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis_db
DATABASE_URL=postgresql://aegis:aegis_password@localhost:5432/aegis_db

# ===================
# Redis Configuration
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# RabbitMQ Configuration
# ===================
RABBITMQ_USER=aegis
RABBITMQ_PASSWORD=aegis_password
RABBITMQ_URL=amqp://aegis:aegis_password@localhost:5672/

# ===================
# Pinecone (Vector DB)
# ===================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=aegis-vectors

# ===================
# Google AI (Gemini)
# ===================
GOOGLE_API_KEY=your_google_api_key

# ===================
# Crypto Exchange APIs
# ===================
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_SECRET_KEY=your_coinbase_secret_key

# ===================
# Stock Market APIs
# ===================
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
POLYGON_API_KEY=your_polygon_api_key

# ===================
# News and Social APIs
# ===================
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
NEWS_API_KEY=your_news_api_key

# ===================
# Email (SMTP)
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=aegis@yourdomain.com

# ===================
# Application Settings
# ===================
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your_super_secret_key_change_in_production

# ===================
# Risk Management
# ===================
MAX_DRAWDOWN_PERCENT=5.0
KILL_SWITCH_LOSS_PERCENT=2.0
DEFAULT_POSITION_SIZE_PERCENT=1.0

# ===================
# Webhook Output (Optional)
# ===================
WEBHOOK_URL=https://your-webhook-endpoint.com/signals
WEBHOOK_AUTH_TOKEN=your_webhook_auth_token
